ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=invites_blog;Username=invites;Password=invites_password
Redis__Configuration=localhost:6379
Jwt__Issuer=invites.blog
Jwt__Audience=invites.blog
Jwt__SigningKey=change-this-in-production-please-use-a-long-random-value
# Optional: the key behind the stable share links hosts send by hand on WhatsApp/Viber/Telegram
# (/i/w...). Left empty, one is derived from Jwt__SigningKey. Changing it changes every share link.
Invites__ShareLinkKey=
Storage__Provider=Minio
Storage__Endpoint=http://localhost:9000
Storage__Bucket=invites-assets
Storage__AccessKey=minio
Storage__SecretKey=minio_password
Email__Provider=Console
Email__ApiKey=
Email__From_Invites=invites.blog <invites@invites.blog>
Email__From_System=invites.blog <no-reply@invites.blog>
Payments__Provider=Fake
Payments__SecretKey=
Payments__WebhookSecret=
Otp__ExpiryMinutes=5
# Channels the OTP endpoint accepts. Add Sms once Sms__MsgOwl__ApiKey is set.
Otp__Channels=Email
# SMS OTP (MsgOwl). No key = ConsoleSmsOtpSender logs the code instead of sending.
# SenderId must be <=11 alphanumeric GSM characters (no dots).
Sms__MsgOwl__ApiKey=
Sms__MsgOwl__SenderId=Invitesblog
Privacy__DefaultRetentionDays=90
Urls__InviterBase=http://localhost:4200
Urls__InviteeBase=http://localhost:4201
Urls__AssetsBase=http://localhost:9000/invites-assets

# Push notifications (FCM). Off unless Enabled is true; the path is a Firebase service-account JSON
# file on the server, never committed.
Push__Enabled=false
Push__ServiceAccountPath=

# Push to iPhones straight through Apple (APNs). Off unless key id, team id and key are all set. The key
# is the .p8 file's contents on one line with \n for newlines; never commit it. The sandbox key is only
# for builds run from Xcode; without it the main key signs those too.
Push__Apns__KeyId=
Push__Apns__TeamId=
Push__Apns__PrivateKey=
Push__Apns__SandboxKeyId=
Push__Apns__SandboxPrivateKey=
Push__Apns__Topic=blog.invites.app
